node_modules/
dist/

# The build stamp, generated into src/ before every compile. Untracked so that
# building never dirties the working tree the stamp is describing.
src/build-stamp.ts
# Walk output. In this repo the graph is only ever produced against the fixture,
# so it is local noise. In a project being tested the graph is meant to be
# committed — it is the baseline a diff compares against.
.uigraph/

# The session file never is, in any project. It holds live cookies.
# Listed separately so un-ignoring the graph cannot take this with it.
.uigraph/session.json
session.json
*.log
.DS_Store

# App Atlas keeps its map here. Local to this machine.
.app-atlas/

# Eval harness scratch space (clones of target repos) and per-run results.
# Results worth keeping get promoted into an issue or eval/README.md by hand.
eval/.work/
eval/results/
